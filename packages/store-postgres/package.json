{
  "name": "@rungsjs/store-postgres",
  "version": "0.1.0",
  "description": "PostgreSQL store for Rungs. Bring your own driver: node-postgres, postgres.js or PGlite.",
  "keywords": [
    "approval",
    "approval-workflow",
    "workflow",
    "rungs",
    "store",
    "postgres",
    "postgresql",
    "pglite",
    "typescript"
  ],
  "homepage": "https://sodastech.github.io/rungs/guides/postgresql/",
  "bugs": {
    "url": "https://github.com/Sodastech/rungs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sodastech/rungs.git",
    "directory": "packages/store-postgres"
  },
  "license": "MIT",
  "author": "Sodastech",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "migrations"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rungsjs/core": "workspace:^"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@rungsjs/core": "workspace:*",
    "@rungsjs/store-contract": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "postgres": "3.4.9"
  }
}
