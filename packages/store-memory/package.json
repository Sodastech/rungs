{
  "name": "@rungsjs/store-memory",
  "version": "0.0.0",
  "description": "In-memory store for Rungs, for tests and prototypes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@rungsjs/core": "workspace:^"
  },
  "devDependencies": {
    "@rungsjs/core": "workspace:*",
    "@rungsjs/store-contract": "workspace:*"
  }
}
