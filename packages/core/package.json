{
  "name": "@rungsjs/core",
  "version": "0.0.0",
  "description": "Pure, deterministic approval workflow engine. Zero runtime dependencies.",
  "keywords": [
    "approval",
    "approval-workflow",
    "workflow",
    "workflow-engine",
    "approvals",
    "delegation",
    "escalation",
    "audit-trail",
    "state-machine",
    "typescript"
  ],
  "homepage": "https://sodastech.github.io/rungs/",
  "bugs": {
    "url": "https://github.com/Sodastech/rungs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sodastech/rungs.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "author": "Sodastech",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "import": "./dist/store.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
