{
  "name": "rungs-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "playground": "turbo run build --filter=@rungsjs/playground^... --output-logs=errors-only && pnpm --filter @rungsjs/playground play",
    "demo": "turbo run build --filter=@rungsjs/example-nextjs-expense^... --output-logs=errors-only && pnpm --filter @rungsjs/example-nextjs-expense dev",
    "lint": "biome check .",
    "check:ec": "node scripts/check-ec-coverage.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:api": "node scripts/api-report.mjs --check",
    "api:update": "node scripts/api-report.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "format": "biome check --write .",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "turbo": "2.11.9",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
